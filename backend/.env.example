PORT=5000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/history_of_music?appName=folkData
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
ADMIN_EMAILS=saba.kapanadze22@gmail.com
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_BYTES=10485760

# test = კოდი UI-ში (SMTP/2FA არ სჭირდება)
# smtp  = რეალური მეილი (მაშინ შეავსე SMTP_*)
EMAIL_MODE=smtp

# მხოლოდ თუ EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=History of Music

# Optional: Georgian -> English admin auto-translation
AI_TRANSLATION_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
